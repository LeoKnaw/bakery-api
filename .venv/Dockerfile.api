FROM python:3.12-slim

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY bakery.py .
COPY models.py .
COPY schema.py .
COPY database.py .
COPY mailing.py .

# Copy .env file (will be overridden by Render env vars)
COPY .env* ./

EXPOSE 8000

CMD ["uvicorn", "bakery:app", "--host", "0.0.0.0", "--port", "8000"]
